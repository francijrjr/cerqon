{
  "name": "cerqon-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Security & Control for Autonomous AI",
  "author": "CERQON Contributors",
  "license": "Apache-2.0",
  "engines": { "node": ">=20.19.0" },
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "cerqon": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
